{
  "name": "rongdhonu-trade",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build",
    "deploy": "wrangler deploy",
    "d1:migrate": "wrangler d1 migrations apply rongdhonu-db --remote",
    "d1:migrate:local": "wrangler d1 migrations apply rongdhonu-db --local",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.3.2",
    "wrangler": "^4.137.0"
  }
}
